Ordinary nullable facade query:
SELECT "d"."id"
FROM "ingres"."date_samples" AS "d"
WHERE CASE
    WHEN "d"."required_date" = ingresdate('') THEN NULL
    ELSE CAST("d"."required_date" AS timestamp without time zone)
END IS NULL
Matched: 1, 4, 5, 6, 7

Native arithmetic query:
-- @fiveDays='432000 seconds' (Nullable = false) (Size = 200)
SELECT "d"."id" AS "Id", CAST("d"."native_value" + ingresdate(@fiveDays) AS varchar(200)) AS "Shifted"
FROM "ingres"."date_samples" AS "d"
WHERE "d"."native_value" >= ingresdate('1582_01_01')
2 + 5 days = 2026-02-05
